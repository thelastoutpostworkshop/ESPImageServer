{
  "name": "esp-image-server-desktop",
  "description": "ESPImageServer desktop application",
  "author": "ESPImageServer",
  "private": true,
  "version": "1.1.3",
  "type": "module",
  "main": "main.mjs",
  "scripts": {
    "build": "npm run prepare:esptool && npm --prefix ../frontend run build && electron-builder --win --x64 --dir",
    "prepare:esptool": "node ./prepare-esptool.mjs",
    "start": "npm run prepare:esptool && electron .",
    "test": "node --test serial-ports.test.mjs runtime.test.mjs firmware.test.mjs firmware-cyd.test.mjs identification.test.mjs wifi.test.mjs firmware-library.test.mjs firmware-releases.test.mjs native-bundle.test.mjs native-installer-config.test.mjs generation-setup.test.mjs generation-close.test.mjs sd-save-close.test.mjs generation-close-lifecycle.test.mjs",
    "test:smoke": "node smoke-test.mjs",
    "build:native": "node build-native.mjs",
    "test:packaged": "node packaged-smoke.mjs",
    "build:native-installer": "node build-native-installer.mjs"
  },
  "devDependencies": {
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "playwright-core": "1.63.0"
  },
  "build": {
    "appId": "com.espimageserver.desktop",
    "productName": "ESPImageServer",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.mjs",
      "runtime.mjs",
      "serial-ports.mjs",
      "preload.cjs",
      "splash.html",
      "package.json",
      "firmware.mjs",
      "firmware-progress.mjs",
      "firmware-library.mjs",
      "firmware-releases.mjs",
      "identification.mjs",
      "wifi.mjs",
      "generation-setup.mjs",
      "generation-close.mjs",
      "sd-save-close.mjs",
      {
        "from": "../frontend/public/about",
        "to": "assets/about",
        "filter": [
          "espimageserver-banner.png"
        ]
      }
    ],
    "win": {
      "target": "dir",
      "icon": "../installer/assets/espimageserver-icon.ico"
    },
    "extraResources": [
      {
        "from": "tools/esptool/esptool-windows-amd64",
        "to": "tools/esptool/esptool-windows-amd64",
        "filter": [
          "esptool.exe",
          "LICENSE",
          "README.md"
        ]
      }
    ],
    "npmRebuild": false,
    "asarUnpack": [
      "node_modules/@serialport/bindings-cpp/prebuilds/**/*"
    ]
  },
  "dependencies": {
    "serialport": "13.0.0",
    "yauzl": "3.4.0"
  }
}
