{
  "name": "esp-image-server-desktop",
  "description": "ESPImageServer desktop application",
  "author": "ESPImageServer",
  "private": true,
  "version": "1.0.79",
  "type": "module",
  "main": "main.mjs",
  "scripts": {
    "build": "npm run prepare:esptool && npm --prefix ../frontend run build && electron-builder --win --x64 --dir",
    "prepare:esptool": "powershell -NoProfile -ExecutionPolicy Bypass -File ./prepare-esptool.ps1",
    "start": "npm run prepare:esptool && electron .",
    "test": "node --test firmware.test.mjs identification.test.mjs wifi.test.mjs firmware-library.test.mjs firmware-releases.test.mjs"
  },
  "devDependencies": {
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.espimageserver.desktop",
    "productName": "ESPImageServer",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.mjs",
      "preload.cjs",
      "splash.html",
      "package.json",
      "firmware.mjs",
      "firmware-library.mjs",
      "firmware-releases.mjs",
      "identification.mjs",
      "wifi.mjs"
    ],
    "win": {
      "target": "dir",
      "icon": "../installer/assets/espimageserver-icon.ico"
    },
    "extraResources": [
      {
        "from": "tools/esptool/esptool-windows-amd64",
        "to": "tools/esptool/esptool-windows-amd64",
        "filter": [
          "esptool.exe",
          "LICENSE",
          "README.md"
        ]
      }
    ],
    "npmRebuild": false,
    "asarUnpack": [
      "node_modules/@serialport/bindings-cpp/prebuilds/**/*"
    ]
  },
  "dependencies": {
    "serialport": "13.0.0",
    "yauzl": "3.4.0"
  }
}
